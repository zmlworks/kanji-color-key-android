<?xml version="1.0" encoding="utf-8"?>
<!-- Layers generated by art/make_icon.py from the project owner's artwork. The foreground is opaque and full-bleed
     (the artwork's own rounded edge is removed), so the launcher's mask is the only mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
