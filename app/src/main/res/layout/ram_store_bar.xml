<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ramStoreBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/section_bg">
    <TextView android:id="@+id/ramStoreHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/ram_store_hint"
        android:textSize="11sp" android:textColor="@color/dim" />
    <TextView android:id="@+id/ramStoreStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text"
        android:paddingTop="2dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/bRamClear" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/ram_store_clear"
            android:textAllCaps="false" />
        <Button android:id="@+id/bRamQuit" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/ram_store_quit"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
