<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/section_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/blockNo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/dim" android:textSize="12sp"
            android:minWidth="20dp" />
        <EditText android:id="@+id/charIn" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="28sp" android:maxLines="1"
            android:inputType="text" android:importantForAutofill="no" android:saveEnabled="false"
            android:imeOptions="actionNext|flagNoPersonalizedLearning" />
        <TextView android:id="@+id/blockErr" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="6dp" android:textColor="@color/err"
            android:textSize="12sp" />
        <Button android:id="@+id/bFallback" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="40dp" android:text="⋯" android:textColor="@color/dim"
            android:contentDescription="@string/restore_fallback_buttons" android:visibility="gone" />
        <Button android:id="@+id/bDeleteBlock" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/restore_delete_block" android:textAllCaps="false"
            android:textColor="@color/dim" />
    </LinearLayout>

    <LinearLayout android:id="@+id/sampleRow" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:visibility="gone" android:gravity="top">
        <com.zmlworks.kanjicolorkey.FlickSurfaceLayout android:id="@+id/sampleBox"
            android:layout_width="180dp" android:layout_height="180dp" android:background="@color/bg" />
        <TextView android:id="@+id/colorNames" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="10dp" android:textSize="18sp"
            android:lineSpacingExtra="6dp" android:textIsSelectable="false" android:textColor="@color/text" />
    </LinearLayout>

    <LinearLayout android:id="@+id/fallbackRow" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/fb0" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="40dp" android:text="黒" />
        <Button android:id="@+id/fb1" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="40dp" android:text="赤" />
        <Button android:id="@+id/fb2" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="40dp" android:text="青" />
        <Button android:id="@+id/fb3" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="40dp" android:text="緑" />
        <Button android:id="@+id/fbQ" style="?android:attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="40dp" android:text="\?" android:textColor="@color/dim" />
    </LinearLayout>
</LinearLayout>
